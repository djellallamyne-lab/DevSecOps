#!/bin/sh
# post-commit: create a portable git bundle after each commit
REPO_ROOT=$(git rev-parse --show-toplevel)
HASH=$(git rev-parse --short HEAD)
OUT_DIR="$REPO_ROOT/backups/git"
mkdir -p "$OUT_DIR"
BUNDLE="$OUT_DIR/HEAD-${HASH}.bundle"
git bundle create "$BUNDLE" --all
echo "Git bundle created: $BUNDLE"

# Optional retention via PowerShell if available
if command -v pwsh >/dev/null 2>&1; then
  pwsh -File "$REPO_ROOT/backup/retention.ps1" || true
elif command -v powershell >/dev/null 2>&1; then
  powershell -File "$REPO_ROOT/backup/retention.ps1" || true
fi
