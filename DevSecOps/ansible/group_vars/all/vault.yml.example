---
# Copy to vault.yml and encrypt with ansible-vault.
# NEVER commit vault.yml in plaintext.
#
#   copy vault.yml.example vault.yml
#   ansible-vault encrypt vault.yml --vault-password-file ~/.ansible-vault-devsecops

vault_jenkins_admin_user: admin
vault_jenkins_admin_password: "CHANGE_ME_strong_jenkins_password"

# Optional: GitLab token for Jenkins webhook / credentials (leave empty if unused)
vault_gitlab_token: ""

# Optional: registry basic auth (leave empty for insecure local registry)
vault_registry_user: ""
vault_registry_password: ""

# Demo app runtime secret injected into K8s Secret at deploy time
vault_demo_api_app_message: "Hello from DevSecOps demo-api (vault)"
