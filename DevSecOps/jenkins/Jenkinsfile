pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  environment {
    APP_DIR         = 'apps/demo-api'
    IMAGE_NAME      = 'demo-api'
    REGISTRY        = 'localhost:5000'
    GIT_SHA         = "${env.GIT_COMMIT?.take(12) ?: 'local'}"
    IMAGE_TAG       = "sha-${GIT_SHA}"
    LOCAL_IMAGE     = "${IMAGE_NAME}:${IMAGE_TAG}"
    REMOTE_IMAGE    = "${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"
    NAMESPACE       = 'demo-dev'
    TRIVY_SEVERITY  = 'HIGH,CRITICAL'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Secret scan (Gitleaks)') {
      steps {
        sh '''
          set -e
          if command -v gitleaks >/dev/null 2>&1; then
            gitleaks detect --source . --config security/gitleaks.toml --verbose --redact
          else
            docker run --rm -v "$PWD:/repo" zricethezav/gitleaks:v8.18.4 \
              detect --source /repo --config /repo/security/gitleaks.toml --verbose --redact
          fi
        '''
      }
    }

    stage('SAST (Semgrep)') {
      steps {
        sh '''
          set -e
          if command -v semgrep >/dev/null 2>&1; then
            semgrep scan --config security/semgrep.yaml --error --metrics=off
          else
            docker run --rm -v "$PWD:/src" returntocorp/semgrep:1.90.0 \
              semgrep scan --config /src/security/semgrep.yaml --error --metrics=off /src
          fi
        '''
      }
    }

    stage('SCA (Trivy fs)') {
      steps {
        sh '''
          set -e
          docker run --rm -v "$PWD:/src" aquasec/trivy:0.56.2 \
            fs --severity HIGH,CRITICAL --exit-code 1 \
            --config /src/security/trivy.yaml /src/${APP_DIR}
        '''
      }
    }

    stage('Build & test (Gradle)') {
      steps {
        dir("${APP_DIR}") {
          sh '''
            set -e
            chmod +x ./gradlew
            ./gradlew clean test bootJar --no-daemon
          '''
        }
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: 'apps/demo-api/build/test-results/test/*.xml'
        }
      }
    }

    stage('Docker build (local only)') {
      steps {
        sh '''
          set -e
          docker build -t "${LOCAL_IMAGE}" -f "${APP_DIR}/Dockerfile" "${APP_DIR}"
          echo "Built local image ${LOCAL_IMAGE} — NOT pushed yet"
        '''
      }
    }

    stage('Gate: Trivy image BEFORE push') {
      steps {
        sh '''
          set -e
          echo "=== Scan-then-push gate: failing HIGH/CRITICAL blocks push ==="
          docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
            -v "$PWD/security:/config" \
            aquasec/trivy:0.56.2 \
            image --severity HIGH,CRITICAL --exit-code 1 \
            --config /config/trivy.yaml \
            "${LOCAL_IMAGE}"
        '''
      }
    }

    stage('SBOM (Syft)') {
      steps {
        sh '''
          set -e
          mkdir -p security/sbom
          docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
            -v "$PWD/security/sbom:/out" \
            anchore/syft:v1.14.0 \
            "${LOCAL_IMAGE}" -o cyclonedx-json=/out/demo-api-${IMAGE_TAG}.cdx.json
        '''
        archiveArtifacts artifacts: 'security/sbom/*.cdx.json', fingerprint: true
      }
    }

    stage('IaC scan (Checkov)') {
      steps {
        sh '''
          set -e
          docker run --rm -v "$PWD:/tf" bridgecrew/checkov:3.2.257 \
            --config-file /tf/security/checkov.yaml \
            -d /tf/helm -d /tf/k8s -d /tf/terraform -d /tf/apps/demo-api \
            --framework dockerfile,kubernetes,helm,terraform \
            --soft-fail-on LOW,MEDIUM
        '''
      }
    }

    stage('Push registry (gates green only)') {
      steps {
        sh '''
          set -e
          docker tag "${LOCAL_IMAGE}" "${REMOTE_IMAGE}"
          docker push "${REMOTE_IMAGE}"
          echo "Pushed ${REMOTE_IMAGE}"
        '''
      }
    }

    stage('Deploy Helm') {
      steps {
        sh '''
          set -e
          helm upgrade --install demo-api helm/demo-api \
            --namespace "${NAMESPACE}" --create-namespace \
            --set image.repository="${REGISTRY}/${IMAGE_NAME}" \
            --set image.tag="${IMAGE_TAG}" \
            --set image.pullPolicy=IfNotPresent \
            --wait --timeout 3m
        '''
      }
    }
  }

  post {
    failure {
      echo 'Pipeline failed — image was NOT pushed if failure was at or before the Trivy gate.'
    }
    success {
      echo "Deployed ${REMOTE_IMAGE} to ${NAMESPACE}"
    }
  }
}
